#!/bin/sh

PIDFILE=/var/run/mainline-switch.pid
WATCHER=/usr/data/wait-creality-start-mainline.sh
LOGFILE=/usr/data/printer_data/logs/mainline-switch.log

case "$1" in
    start)
        if [ -f "$PIDFILE" ]; then
            pid=$(cat "$PIDFILE" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                exit 0
            fi
            rm -f "$PIDFILE"
        fi
        HOME=/root /bin/sh "$WATCHER" >>"$LOGFILE" 2>&1 &
        echo $! >"$PIDFILE"
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
            pid=$(cat "$PIDFILE" 2>/dev/null)
            [ -z "$pid" ] || kill "$pid" 2>/dev/null || true
            rm -f "$PIDFILE"
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac
